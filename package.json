{
  "name": "PseudoTranslator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build-electron && concurrently -k \"vite\" \"wait-on http://localhost:${DEV_PORT:-5173} && electron .\"",
    "build-electron": "node scripts/build-electron.mjs",
    "build": "npm run build-electron && vite build",
    "start": "node scripts/build-electron.mjs && electron .",
    "lint": "npm run test:lint",
    "test": "npm run test:typecheck && npm run test:lint && npm run test:unit && npm run test:e2e -- --grep @smoke",
    "test:watch": "vitest",
    "test:typecheck": "tsc --build --force",
    "test:lint": "oxlint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:regression": "playwright test --grep @regression",
    "test:all": "npm run test:typecheck && npm run test:lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "htmx.org": "^2.0.10",
    "sheepdog": "^1.0.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24.13.2",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.1",
    "electron": "^36.2.1",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.11.0",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4"
  }
}